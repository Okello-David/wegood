# Copy to .env.local and fill in values. Never commit real values.
# NEXT_PUBLIC_ variables are bundled into browser code, so only safe public values may use that prefix.

# Phase 0: Supabase, public (Row Level Security protects the data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only: never add NEXT_PUBLIC_ to these
SUPABASE_SERVICE_ROLE_KEY=

# Phase 3: Web Push
# The public key is safe in the browser: it only lets a phone check that a push
# really came from our server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# The next four are NOT read by the Next.js app. They belong to the `notify`
# Edge Function: put them in supabase/functions/.env for local work and in
# `npx supabase secrets set` for the hosted project. See docs/SETUP.md step 11.
# VAPID_PUBLIC_KEY is the same value as NEXT_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NOTIFY_HOOK_SECRET=

# Phase 6: AWS (server-side only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
